# =============================================================================
# FACEBOOK / META OAUTH
# =============================================================================
META_APP_ID=your_facebook_app_id_here
META_APP_SECRET=your_facebook_app_secret_here
META_REDIRECT_URI=https://yourdomain.com/api/integrations/meta/callback
META_API_VERSION=v20.0
# Optional: For webhook verification
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Legacy Facebook variables (kept for backward compatibility)
FACEBOOK_APP_ID=${META_APP_ID}
FACEBOOK_APP_SECRET=${META_APP_SECRET}
FACEBOOK_REDIRECT_URI=${META_REDIRECT_URI}