# =============================================================================
# DEFESAI / ADEUS MULTA - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# --- CORE APPLICATION CONFIGURATION ---
# APP_URL: The public base URL where this application is hosted.
# Used for webhook callbacks, self-referential links, and OAuth redirect URIs.
APP_URL="https://app.defesai.com.br"

# NODE_ENV: Application environment mode ('development' | 'production')
NODE_ENV="production"

# PORT: Listening port (Fixed to 3000 in AI Studio / Cloud Run)
PORT=3000


# --- AI & LLM PROVIDERS ---
# GEMINI_API_KEY: Google Gemini API key for multimodal OCR & legal thesis reasoning.
GEMINI_API_KEY=""

# NVIDIA_API_KEY: Primary AI Gateway provider (NVIDIA NIM Llama-3.1-70b-instruct).
NVIDIA_API_KEY=""

# NINEROUTER_API_KEY: Fallback AI Gateway provider (9Router DeepSeek R1).
NINEROUTER_API_KEY=""


# --- DATABASE & AUTH (SUPABASE) ---
# SUPABASE_URL: Base URL of your Supabase PostgreSQL instance.
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public anonymous key for client-side Auth.
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Backend-only admin key (bypasses RLS for repository sync).
SUPABASE_SERVICE_ROLE_KEY=""


# --- FINANCIAL GATEWAY (PAGBANK / PAGSEGURO) ---
# PAGBANK_ENV: 'sandbox' for testing or 'production' for live transactions.
PAGBANK_ENV="sandbox"

# PAGBANK_TOKEN: Bearer token generated in the PagBank Developer Portal.
PAGBANK_TOKEN=""

# PAGBANK_EMAIL: Primary merchant account email.
PAGBANK_EMAIL="financeiro@defesai.com.br"

# PAGBANK_WEBHOOK_SECRET: Secret key for verifying HMAC-SHA256 webhook signatures.
PAGBANK_WEBHOOK_SECRET=""


# --- MARKETING & SOCIAL (META GRAPH API) ---
# META_APP_ID: Facebook App ID for OAuth and Instagram Graph API v19+.
META_APP_ID=""

# META_APP_SECRET: Facebook App Secret for token exchange.
META_APP_SECRET=""

# META_ACCESS_TOKEN: Long-lived system user token for autonomous posting.
META_ACCESS_TOKEN=""

# META_PAGE_ID: Target Facebook Page ID.
META_PAGE_ID=""

# INSTAGRAM_ACCOUNT_ID: Connected Instagram Business Account ID.
INSTAGRAM_ACCOUNT_ID=""


# --- NOTIFICATIONS (WHATSAPP / EVOLUTION API) ---
# EVOLUTION_API_KEY: API Key for Evolution WhatsApp Gateway.
EVOLUTION_API_KEY=""


# --- CRYPTOGRAPHY & SECURITY ---
# ENCRYPTION_KEY: 32-byte master key for AES-256-GCM local secret storage.
ENCRYPTION_KEY=""
